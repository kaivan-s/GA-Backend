option_settings:
  # Point the load balancer health check at the app's health route
  # (there is no "/" route, only /healthz and /readyz).
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /healthz
    Port: "8000"
    Protocol: HTTP

  # Non-secret runtime config. Set actual SECRETS (Supabase/Clerk/Apple/APNs
  # keys) via the EB console > Configuration > Software, or `eb setenv ...`.
  aws:elasticbeanstalk:application:environment:
    FLASK_ENV: production
    LOG_LEVEL: INFO
