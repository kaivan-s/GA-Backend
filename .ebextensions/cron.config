files:
  "/etc/cron.d/reminder_scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      */15 * * * * root /usr/local/bin/run_reminder_scheduler.sh >> /var/log/reminder_scheduler.log 2>&1

  "/usr/local/bin/run_reminder_scheduler.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      # Load environment variables from Elastic Beanstalk
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        export $(cat /opt/elasticbeanstalk/deployment/env | xargs)
      fi
      
      # Alternatively try the newer location
      if [ -f /opt/elasticbeanstalk/deployment/env.list ]; then
        while IFS= read -r line; do
          export "$line"
        done < /opt/elasticbeanstalk/deployment/env.list
      fi
      
      # Find the virtualenv python
      VENV_PYTHON=$(ls /var/app/venv/*/bin/python 2>/dev/null | head -1)
      
      if [ -z "$VENV_PYTHON" ]; then
        echo "[$(date)] ERROR: Could not find virtualenv python"
        exit 1
      fi
      
      cd /var/app/current
      
      echo "[$(date)] Running reminder scheduler with $VENV_PYTHON"
      $VENV_PYTHON -m app.workers.reminder_scheduler

commands:
  remove_old_cron:
    command: "rm -f /etc/cron.d/*.bak"
