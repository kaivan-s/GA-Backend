files:
  "/etc/cron.d/reminder_scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      */15 * * * * root /var/app/venv/*/bin/python /var/app/current/app/workers/reminder_scheduler.py >> /var/log/reminder_scheduler.log 2>&1

commands:
  remove_old_cron:
    command: "rm -f /etc/cron.d/*.bak"
