# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_service_role_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Clerk
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWKS_URL=https://xxx.clerk.accounts.dev/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Apple IAP (In-App Purchases)
# Product IDs are configured in App Store Connect
# Webhooks: Set App Store Server Notifications URL to https://your-backend.com/webhooks/apple

# APNs (Push Notifications)
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_TOPIC=com.gratidude.app
APNS_SANDBOX=false  # true for development

# Application
EVENING_CUTOFF_HOUR=17
LOG_LEVEL=INFO
APP_BASE_URL=https://your-backend.com
